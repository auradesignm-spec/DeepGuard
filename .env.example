# Root Environment Example
OPENAI_API_KEY=your_openai_api_key_here
HF_REPO_ID=auradesignm/deepfake-detection-keras
MODEL_PATH=final_deepfake_model.keras
# Hugging Face detector ensemble (geometric mean) used by the backend
DETECTOR_MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model
DETECTOR_ENSEMBLE_ENABLED=true
DETECTOR_MODEL_ID_SECONDARY=Organika/sdxl-detector
BACKEND_URL=http://localhost:8000
PORT=3000
HOST=0.0.0.0

# Archil persistent/shared disk (optional). Create an account + API key at
# https://console.archil.com then put the real values in .env (never commit).
# Regions supporting serverless exec: aws-us-east-1, aws-us-west-2, aws-eu-west-1
ARCHIL_API_KEY=your_archil_api_key_here
ARCHIL_REGION=aws-us-east-1
