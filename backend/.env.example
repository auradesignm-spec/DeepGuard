# Hugging Face detector ensemble (geometric mean) used by app.services.detector
DETECTOR_MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model
DETECTOR_ENSEMBLE_ENABLED=true
DETECTOR_MODEL_ID_SECONDARY=Organika/sdxl-detector
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
